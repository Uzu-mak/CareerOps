APP_NAME=CareerOps
ENVIRONMENT=local
DATABASE_URL=sqlite:///./careerops.db
BASE_URL=http://localhost:8000
LLM_PROVIDER=local
AWS_REGION=us-west-2
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
S3_BUCKET=
SES_FROM_EMAIL=
SES_TO_EMAIL=
AUTO_SUBMIT_ENABLED=false
BROWSER_HEADLESS=true
CHROMIUM_EXECUTABLE=/usr/bin/chromium
SECRET_KEY=replace-me-in-production
DEMO_FULL_NAME=Your Name
DEMO_PREFERRED_NAME=You
DEMO_EMAIL=
DEMO_PHONE=
DEMO_HOME_LOCATION=Seattle, WA
DEMO_LINKEDIN_URL=
DEMO_GITHUB_URL=

# Broad-market discovery providers
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
USAJOBS_API_KEY=
USAJOBS_USER_AGENT=

# Notification channels (optional; can also be configured in the UI)
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_INGEST_TOKEN=replace-with-random-secret

# Optional automatic LinkedIn/Indeed alert-email ingestion via IMAP
JOB_ALERT_IMAP_HOST=
JOB_ALERT_IMAP_PORT=993
JOB_ALERT_IMAP_USER=
JOB_ALERT_IMAP_PASSWORD=
JOB_ALERT_IMAP_FOLDER=INBOX
